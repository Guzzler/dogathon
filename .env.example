# Required.
ANTHROPIC_API_KEY=sk-ant-...

# Required for Firestore access. On Cloud Run this is picked up automatically
# from the environment; for local dev, set it explicitly (or run
# `gcloud auth application-default login` once and leave this unset).
FIREBASE_PROJECT_ID=pawthway-hackathon

# Optional. Setting ARCADE_API_KEY turns on the Arcade.dev toolkits
# (Gmail, Sheets, Slack, ...). Without it the agent runs on builtin tools only.
# ARCADE_API_KEY=arc_...
# ARCADE_USER_ID=you@example.com
# ARCADE_TOOLKITS=gmail,google_sheets,slack
