rules_version = '2';

// Each foster owns exactly one document, keyed by their Firebase Auth uid, plus its
// careLog subcollection. Nobody can read or write anyone else's journey.
service cloud.firestore {
  match /databases/{database}/documents {
    function isStaff(shelterId) {
      return request.auth != null &&
        request.auth.uid in get(/databases/$(database)/documents/shelters/$(shelterId)).data.staffUids;
    }

    match /dogs/{dogId} {
      allow read: if true;
      // RS-6 (M3): a shelter's own staff may add and retire that shelter's own dogs.
      // This is the one deliberate, scoped relaxation of what used to be a blanket
      // `allow write: if false` -- nothing else about dogs changed. The agent backend
      // still writes status/adoption_profile through the Admin SDK, which bypasses these
      // rules entirely and is unaffected either way.
      allow create: if isStaff(request.resource.data.shelter_id);
      // shelter_id is pinned across an update, so staff at one shelter can neither move a
      // dog into another shelter's roster nor take over one they don't already own: the
      // isStaff() check reads the *stored* shelter_id, and the equality stops the write
      // from changing it afterwards.
      allow update: if isStaff(resource.data.shelter_id)
                    && request.resource.data.shelter_id == resource.data.shelter_id;
      // Retiring is a status change, never a delete. A foster mid-application resolves
      // their dog by id from three separate phases, so deleting it strands them with no
      // route back -- the same reason scripts/import_dogs.py keeps a matched stale dog.
      allow delete: if false;
    }

    match /fosters/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /careLog/{entryId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // The agent's persisted transcript (session_store.py). Only the Admin
      // SDK writes it -- that bypasses these rules entirely, so this is
      // belt-and-suspenders documentation of intent, not the only thing
      // stopping a client write, but it's explicit rather than relying on
      // the default-deny at the bottom of the file to say so.
      match /agentSession/{doc} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }
    }

    // A relationship between a foster and a shelter, queryable from both sides -- see
    // docs/shelter-integration.md. matchedDogId/approvalChecklist/pickup on fosters/{uid}
    // stay as read-through convenience fields; this collection is the source of truth.
    match /applications/{applicationId} {
      allow read: if request.auth != null && (
        resource.data.fosterId == request.auth.uid || isStaff(resource.data.shelterId)
      );
      // A foster opens an application for themselves; only staff move it forward. RS-15: and
      // it opens with no answer from the shelter already on it -- the three answer fields are
      // staff's, and a create is the one write the update branches below never see.
      allow create: if request.auth != null
                    && request.resource.data.fosterId == request.auth.uid
                    && request.resource.data.status == "submitted"
                    && request.resource.data.get("pickupConfirmedAt", null) == null
                    && request.resource.data.get("pickupDeclinedAt", null) == null
                    && request.resource.data.get("pickupNote", null) == null;
      // The foster branch is deliberately narrow: withdrawing your own application, and
      // nothing else. Requiring only the resulting status let a single write set it *and*
      // rewrite `checklist` (undoing a shelter's ticks), `createdAt`, or `shelterId` -- the
      // last of which drops the row into another shelter's inbox, since the staff-side list
      // query filters on exactly that field. The staff branch is untouched: staff moving an
      // application forward is supposed to write the checklist.
      //
      // !! `fosterName` is deliberately NOT pinned, and must stay that way. Account deletion
      // !! redacts it to "(deleted account)" through this same branch -- see deleteAccount()
      // !! in web/src/auth.ts (PH-15). Pinning it would close a hole and break deletion in
      // !! the same change, and there would be no way to remove a deleted person's name from
      // !! a shelter's inbox afterwards: this branch needs their uid, which never signs in
      // !! again.
      allow update: if isStaff(resource.data.shelterId)
                    || (resource.data.fosterId == request.auth.uid
                        && request.resource.data.status == "withdrawn"
                        && request.resource.data.fosterId == resource.data.fosterId
                        && request.resource.data.shelterId == resource.data.shelterId
                        && request.resource.data.dogId == resource.data.dogId
                        && request.resource.data.createdAt == resource.data.createdAt
                        && request.resource.data.checklist == resource.data.checklist)
                    // RS-14: the foster's pickup request, written where the shelter can read it.
                    // Only `pickup`, `pickupConfirmedAt` and `updatedAt` may change, so status,
                    // checklist, fosterName and the ids are all pinned by the one `hasOnly`, on
                    // an application that is still live (never on a declined or withdrawn one).
                    // `pickupConfirmedAt` is the shelter's answer: a foster may clear it -- which
                    // every new slot does -- but may only leave it set if the slot is untouched.
                    // A foster can un-confirm by changing the request and can never confirm.
                    // `.get(..., null)` because applications written before RS-14 lack the field.
                    // RS-15 adds the shelter's other answer, `pickupDeclinedAt` and its
                    // `pickupNote`, on exactly the same terms: a foster may clear each (every new
                    // request does), may leave it set only while the slot is untouched, and can
                    // never set it -- a foster must never write a note in the shelter's voice.
                    || (resource.data.fosterId == request.auth.uid
                        && resource.data.status in ["submitted", "in_review", "approved"]
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(["pickup", "pickupConfirmedAt", "pickupDeclinedAt", "pickupNote", "updatedAt"])
                        && (request.resource.data.get("pickupConfirmedAt", null) == null
                            || !request.resource.data.diff(resource.data).affectedKeys()
                                  .hasAny(["pickup", "pickupConfirmedAt"]))
                        && (request.resource.data.get("pickupDeclinedAt", null) == null
                            || !request.resource.data.diff(resource.data).affectedKeys()
                                  .hasAny(["pickup", "pickupDeclinedAt"]))
                        && (request.resource.data.get("pickupNote", null) == null
                            || !request.resource.data.diff(resource.data).affectedKeys()
                                  .hasAny(["pickup", "pickupNote"])));
    }

    // PH-32: what a foster has *published* about the dog they fostered -- the one place a
    // stranger opening the shared adoption link may read. `fosters/{uid}` stays owner-only;
    // this is a separate, scoped branch holding only what the foster chose to publish.
    //
    // The write is pinned to the shelter's act, not the foster's claim. `matchedDogId` is
    // foster-writable, so a rule keyed on it would let anyone publish a page for any dog. An
    // application carrying `pickupConfirmedAt` is a stamp only staff can set (RS-14/RS-15
    // branches above), so the foster must name that application and the rule reads it back.
    //
    // And a page is visible exactly as long as that act holds: `get` runs the same predicate at
    // read time (a rules `get()` is not subject to the target's own read rule), so staff taking
    // the confirmation back, or declining, hides the page with no cleanup path -- staff can't
    // delete a foster's document, and don't need to. The predicate is *stamped and not
    // declined/withdrawn* rather than *live*, so a finished foster (RS-22's `completed`) keeps
    // their page up while the dog is relisted for adoption, which is when it is read.
    //
    // A missing document may be read (it holds nothing), so an unpublished link degrades to the
    // shelter's record without a permission error. `list` is the owner's only -- deleteAccount()
    // and export need it; strangers may not enumerate who published what.
    function publishAuthorized(applicationId, fosterId, dogId) {
      return get(/databases/$(database)/documents/applications/$(applicationId)).data.fosterId == fosterId
        && get(/databases/$(database)/documents/applications/$(applicationId)).data.dogId == dogId
        && get(/databases/$(database)/documents/applications/$(applicationId)).data.get("pickupConfirmedAt", null) != null
        && !(get(/databases/$(database)/documents/applications/$(applicationId)).data.status in ["declined", "withdrawn"]);
    }

    match /adoptionProfiles/{dogId} {
      allow get: if resource == null
                 || publishAuthorized(resource.data.applicationId, resource.data.fosterId, dogId);
      allow list: if request.auth != null && resource.data.fosterId == request.auth.uid;
      allow create: if request.auth != null
                    && request.resource.data.fosterId == request.auth.uid
                    && request.resource.data.dogId == dogId
                    && publishAuthorized(request.resource.data.applicationId, request.auth.uid, dogId);
      // No overwriting another foster's page by being confirmed on the same dog later.
      allow update: if request.auth != null
                    && resource.data.fosterId == request.auth.uid
                    && request.resource.data.fosterId == request.auth.uid
                    && request.resource.data.dogId == dogId
                    && publishAuthorized(request.resource.data.applicationId, request.auth.uid, dogId);
      allow delete: if request.auth != null && resource.data.fosterId == request.auth.uid;
    }

    // staffUids is what lets the rules above express "is this person staff here" without a
    // custom-claims setup. No self-serve signup yet -- uids are added by hand (M3).
    match /shelters/{shelterId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.staffUids;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
