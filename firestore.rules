rules_version = '2';

// There's no auth yet, so these rules can't express "only the owner". What they
// do instead is constrain the shape of what a client may touch: each browser
// mints an unguessable id (web/src/lib/fosterId.ts) and writes only under that
// document, so one visitor can no longer stomp on another's journey by default.
//
// This is isolation, not access control. Anyone who learns an id can read that
// journey. Before this holds anything sensitive, add Firebase Auth and change
// the match below to `if request.auth.uid == fosterId`.
service cloud.firestore {
  match /databases/{database}/documents {
    match /dogs/{dogId} {
      allow read: if true;
      // Dog status/adoption profile only changes via the agent backend
      // (Admin SDK bypasses these rules), not directly from the client.
      allow write: if false;
    }

    // `f_` + 20 hex chars, or the seeded demo foster. Keep in sync with
    // FOSTER_ID_PATTERN in web/src/lib/fosterId.ts.
    match /fosters/{fosterId} {
      allow read, write: if fosterId == 'annie'
                         || fosterId.matches('^f_[a-f0-9]{20}$');

      match /careLog/{entryId} {
        allow read, write: if fosterId == 'annie'
                           || fosterId.matches('^f_[a-f0-9]{20}$');
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
