rules_version = '2';

// Each foster owns exactly one document, keyed by their Firebase Auth uid, plus its
// careLog subcollection. Nobody can read or write anyone else's journey.
service cloud.firestore {
  match /databases/{database}/documents {
    match /dogs/{dogId} {
      allow read: if true;
      // Dog status/adoption profile only changes via the agent backend
      // (Admin SDK bypasses these rules), not directly from the client.
      allow write: if false;
    }

    match /fosters/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /careLog/{entryId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
