# Firebase web app config -- all public/client-safe values (get these from
# `firebase apps:sdkconfig web` or the Firebase console after creating the
# project). Also set VITE_AGENT_URL once the Cloud Run agent is deployed.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Local dev leaves this unset (Vite proxies /api -> 127.0.0.1:8000). Set it
# to the deployed Cloud Run URL for production builds.
VITE_AGENT_URL=

# Google sign-in also needs, in the Firebase console:
#   Authentication > Sign-in method > enable Google
#   Authentication > Settings > Authorized domains > add your deploy domain
# Without any of this the app still runs — sign-in disables itself and the
# journey runs in guest mode against localStorage.
